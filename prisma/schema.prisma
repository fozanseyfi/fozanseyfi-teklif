generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["solar", "public"]
}

// =============================================================================
// Paylasilan kimlik tablolari (public schema) — Karardestek tarafindan yonetilir.
// 4 site arasinda ortak. Bu projenin tablolari `solar` schema'sinda izole tutulur.
// =============================================================================

model Profile {
  id                  String   @id @db.Uuid // = auth.users.id
  email               String?
  fullName            String?  @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  role                String   // 'admin' | 'user' | 'viewer' — active org icindeki rol
  organizationId     String   @map("organization_id") @db.Uuid
  organization       Organization @relation("ActiveOrg", fields: [organizationId], references: [id])
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  memberships  OrganizationMember[]
  ownedOrgs    Organization[]       @relation("OrgOwner")
  projects     Project[]            @relation("ProjectCreatedBy")

  @@map("profiles")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String?  @map("owner_id") @db.Uuid
  owner     Profile? @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       OrganizationMember[]
  activeMembers Profile[]            @relation("ActiveOrg")
  projects      Project[]
  subscription  Subscription?

  @@map("organizations")
  @@schema("public")
}

model OrganizationMember {
  userId         String       @map("user_id") @db.Uuid
  user           Profile      @relation(fields: [userId], references: [id])
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Platform-scoped: 'karar-destek' | 'solar-teklif' | ... — bir kullanici
  // bir org'a farkli platformlarda farkli rollerde uye olabilir.
  platform       String
  role           String       // 'admin' | 'user' | 'viewer'
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@id([userId, organizationId, platform])
  @@map("organization_members")
  @@schema("public")
}

// =============================================================================
// Bu projenin domain tablolari (solar schema)
// =============================================================================

model Project {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdById     String       @db.Uuid
  createdBy       Profile      @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  name            String
  customerName    String  @default("")
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  projectLocation String  @default("")

  installationType InstallationType @default(ROOFTOP)
  systemSize       SystemSize       @default(SMALL)

  panelCount    Int   @default(0)
  panelPowerWp  Float @default(0)
  inverterCount Int   @default(0)
  totalAreaM2   Float @default(0)
  perimeterM    Float @default(0)
  totalPowerKw  Float @default(0)

  electricityTariff    TariffType @default(RESIDENTIAL)
  electricityUnitPrice Float      @default(0)

  annualInflationRate       Float @default(0.40)
  electricityEscalationRate Float @default(0.35)
  projectLifeYears          Int   @default(25)

  status      ProjectStatus @default(DRAFT)
  currentStep Int           @default(1)

  isTemplate    Boolean @default(false)
  templateLabel String?
  templateOrder Int     @default(0)
  templateLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingSnapshot PricingSnapshot?
  equipmentItems  EquipmentItem[]
  costItems       CostItem[]
  proposal        Proposal?
  projectDetail   ProjectDetail?

  @@index([isTemplate, templateOrder])
  @@index([organizationId])
  @@schema("solar")
}

model ProjectDetail {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kesifA    Json     @default("[]")
  kesifB    Json     @default("[]")
  timeline  Json     @default("{}")
  dor       Json     @default("[]")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("solar")
}

enum InstallationType {
  ROOFTOP
  GROUND_MOUNTED

  @@schema("solar")
}

enum SystemSize {
  SMALL
  LARGE

  @@schema("solar")
}

enum TariffType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL

  @@schema("solar")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SENT
  CLOSE_WIN
  CLOSE_LOST
  CANCELLED

  @@schema("solar")
}

model PricingSnapshot {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  referencePricePerKw Float
  baseTotalPrice      Float

  finalEquipmentCost    Float
  finalInstallationCost Float
  finalEngineeringCost  Float
  finalOtherCosts       Float
  finalTotalCost        Float
  profitMarginPercent   Float @default(0.20)
  finalSalePrice        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("solar")
}

model EquipmentItem {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   EquipmentCategory
  brand      String?
  model      String?
  quantity   Int
  unitPrice  Float
  totalPrice Float
  notes      String?
  sortOrder  Int               @default(0)

  @@schema("solar")
}

enum EquipmentCategory {
  PANEL
  INVERTER
  MOUNTING_SYSTEM
  DC_CABLE
  AC_CABLE
  JUNCTION_BOX
  MONITORING_SYSTEM
  PROTECTION_EQUIPMENT
  TRANSFORMER
  OTHER

  @@schema("solar")
}

model CostItem {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  description String
  amount      Float
  notes       String?

  @@schema("solar")
}

enum CostCategory {
  INSTALLATION_LABOR
  ENGINEERING_DESIGN
  PERMITS_LICENSING
  TRANSPORTATION
  COMMISSIONING
  INSURANCE
  OTHER

  @@schema("solar")
}

model Proposal {
  id          String    @id @default(cuid())
  projectId   String    @unique
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pdfUrl      String?
  generatedAt DateTime?
  sentAt      DateTime?
  version     Int       @default(1)

  coverNote        String?
  validityDays     Int     @default(30)
  includedSections Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("solar")
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique @map("organization_id") @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id])
  plan                 PlanType
  status               SubStatus
  monthlyProposalLimit Int
  currentMonthCount    Int          @default(0)
  periodStart          DateTime
  periodEnd            DateTime
  createdAt            DateTime     @default(now())

  @@schema("solar")
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE

  @@schema("solar")
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE

  @@schema("solar")
}

model ReferencePriceTable {
  id               String           @id @default(cuid())
  powerKw          Float
  installationType InstallationType
  pricePerKw       Float
  validFrom        DateTime
  notes            String?
  updatedAt        DateTime         @updatedAt

  @@schema("solar")
}

model ElectricityTariff {
  id            String     @id @default(cuid())
  type          TariffType
  unitPrice     Float
  effectiveDate DateTime
  source        String?

  @@schema("solar")
}

model PlatformSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@schema("solar")
}
