generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["solar", "public"]
}

// =============================================================================
// Paylasilan kimlik tablolari (public schema) — Karardestek tarafindan yonetilir.
// 4 site arasinda ortak. Bu projenin tablolari `solar` schema'sinda izole tutulur.
// =============================================================================

model Profile {
  id                  String   @id @db.Uuid // = auth.users.id
  email               String?
  fullName            String?  @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  role                String   // 'admin' | 'user' | 'viewer' — active org icindeki rol
  organizationId     String   @map("organization_id") @db.Uuid
  organization       Organization @relation("ActiveOrg", fields: [organizationId], references: [id])
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  memberships  OrganizationMember[]
  ownedOrgs    Organization[]       @relation("OrgOwner")
  projects     Project[]            @relation("ProjectCreatedBy")
  invitations  Invitation[]         @relation("Inviter")

  hiddenResources    UserHiddenResource[] @relation("HiddenForUser")
  hiddenByMe         UserHiddenResource[] @relation("HiderProfile")
  lockedResources    UserLockedResource[] @relation("LockedForUser")
  lockedByMe         UserLockedResource[] @relation("LockerProfile")

  @@map("profiles")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String?  @map("owner_id") @db.Uuid
  owner     Profile? @relation("OrgOwner", fields: [ownerId], references: [id])
  // Marka ayarlari (PDF/Excel ciktilarinda kullanilir, web UI'yi etkilemez).
  // JSON sema:
  //   {
  //     logoUrl?: string,         // Supabase Storage public URL
  //     logoEnabled?: boolean,    // PDF'lerde logo gosterilsin mi (default false)
  //     color?: string,           // Hex (#RRGGBB), default emerald
  //     colorEnabled?: boolean,   // Renk PDF kapaklarinda kullanilsin mi
  //     slogan?: string,
  //     sloganEnabled?: boolean,
  //     watermarkEnabled?: boolean, // Sayfa arkasi capraz filigran
  //     taxNumber?: string,
  //     contact?: string,
  //   }
  // Footer doc-id ve hazirlayan kullanici email'i her zaman basilir (kapatilamaz).
  brandSettings Json @default("{}") @map("brand_settings")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       OrganizationMember[]
  activeMembers Profile[]            @relation("ActiveOrg")
  invitations   Invitation[]
  projects      Project[]
  subscription  Subscription?

  hiddenResources UserHiddenResource[] @relation("HiddenInOrg")
  lockedResources UserLockedResource[] @relation("LockedInOrg")
  auditLogs       AuditLog[]
  shareLinks      ShareLink[]

  @@map("organizations")
  @@schema("public")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  email          String
  role           String       // 'admin' | 'user' | 'viewer'
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  token          String       @unique
  expiresAt      DateTime     @map("expires_at")
  invitedBy      String?      @map("invited_by") @db.Uuid
  inviter        Profile?     @relation("Inviter", fields: [invitedBy], references: [id])
  acceptedAt     DateTime?    @map("accepted_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
  @@schema("public")
}

model OrganizationMember {
  userId         String       @map("user_id") @db.Uuid
  user           Profile      @relation(fields: [userId], references: [id])
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String       // 'admin' | 'user' | 'viewer'
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@id([userId, organizationId])
  @@map("organization_members")
  @@schema("public")
}

// Negatif izin: admin bir kaynagi belirli bir user'dan tamamen gizler.
// resourceType: 'project' (sablonlar dahil) | 'customer'
// resourceId: project.id (string/cuid) — `solar` schema'sindaki projeye foreign key
// veremiyoruz cunku FK cross-schema olabiliyor ama silme cascade'i app layer'da
// resource silindiginde yetenek silinmesi gerek. Burada cleanup app-layer'da yapilir.
model UserHiddenResource {
  userId         String       @map("user_id") @db.Uuid
  user           Profile      @relation("HiddenForUser", fields: [userId], references: [id], onDelete: Cascade)
  resourceType   String       @map("resource_type") // 'project' | 'customer'
  resourceId     String       @map("resource_id")
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("HiddenInOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  hiddenBy       String?      @map("hidden_by") @db.Uuid
  hider          Profile?     @relation("HiderProfile", fields: [hiddenBy], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([userId, resourceType, resourceId])
  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("user_hidden_resources")
  @@schema("public")
}

// Read-only kilit: admin bir user'i belirli bir kaynakta sadece goruntuleyici yapar.
model UserLockedResource {
  userId         String       @map("user_id") @db.Uuid
  user           Profile      @relation("LockedForUser", fields: [userId], references: [id], onDelete: Cascade)
  resourceType   String       @map("resource_type") // 'project' | 'customer'
  resourceId     String       @map("resource_id")
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("LockedInOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  lockedBy       String?      @map("locked_by") @db.Uuid
  locker         Profile?     @relation("LockerProfile", fields: [lockedBy], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([userId, resourceType, resourceId])
  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("user_locked_resources")
  @@schema("public")
}

// =============================================================================
// Bu projenin domain tablolari (solar schema)
// =============================================================================

model Project {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdById     String       @db.Uuid
  createdBy       Profile      @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  name            String
  customerName    String  @default("")
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  projectLocation String  @default("")

  installationType InstallationType @default(ROOFTOP)
  systemSize       SystemSize       @default(SMALL)

  panelCount    Int   @default(0)
  panelPowerWp  Float @default(0)
  inverterCount Int   @default(0)
  totalAreaM2   Float @default(0)
  perimeterM    Float @default(0)
  totalPowerKw  Float @default(0)

  electricityTariff    TariffType @default(RESIDENTIAL)
  electricityUnitPrice Float      @default(0)

  annualInflationRate       Float @default(0.40)
  electricityEscalationRate Float @default(0.35)
  projectLifeYears          Int   @default(25)

  status      ProjectStatus @default(DRAFT)
  currentStep Int           @default(1)

  // Teklif tipi: TURNKEY = anahtar teslim GES projesi (teknik+keşif+timeline
  // akışı), MATERIAL_SERVICE = malzeme & hizmet teklifi (sade kalem listesi).
  quoteKind   ProjectKind   @default(TURNKEY) @map("quote_kind")

  // Satış pipeline'ı — Project.status'tan AYRI bir eksen. status proje yaşam
  // döngüsü (taslak/devam/tamamlandı), pipelineStage satış sürecidir
  // (gönderildi → inceleniyor → revizyon → kazanıldı/kaybedildi).
  // null = pipeline'a girmemiş (henüz paylaşılmamış taslak).
  pipelineStage  PipelineStage? @map("pipeline_stage")
  // Sadece pipelineStage = LOST iken doldurulur. Yıl sonu raporlamada altın değerinde.
  lostReason     LostReason?    @map("lost_reason")
  // Rakip bilgisi — kaybedilen tekliflerde "kime kaybettik?"
  competitorName String?        @map("competitor_name")

  isTemplate    Boolean @default(false)
  templateLabel String?
  templateOrder Int     @default(0)
  templateLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingSnapshot PricingSnapshot?
  equipmentItems  EquipmentItem[]
  costItems       CostItem[]
  proposal        Proposal?
  projectDetail   ProjectDetail?
  shareLinks      ShareLink[]
  activities      ProjectActivity[]

  @@index([isTemplate, templateOrder])
  @@index([organizationId])
  @@index([pipelineStage])
  @@schema("solar")
}

/// Audit log — kim, ne zaman, hangi projede, ne yaptı? Yöneticilerin
/// görebileceği zaman damgalı kayıt akışı. Foreign key actor (Profile) için
/// YOKTU bilinçli — kullanıcı silinse bile log korunur, sadece email/name
/// snapshot saklanır.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?      @map("actor_id") @db.Uuid
  actorEmail     String?      @map("actor_email")
  actorName      String?      @map("actor_name")

  // Insanca okunabilir aksiyon adi: "save_project_info", "save_teknik",
  // "save_kesif_a", "save_kesif_b", "save_timeline", "save_dor",
  // "delete_project", "use_template", "create_project", "invite_user", vb.
  action         String

  // resourceType: "project" | "template" | "user" | "settings"
  resourceType   String       @map("resource_type")
  resourceId     String?      @map("resource_id")
  // Snapshot: proje silinse bile log'da hangi proje olduğu görülsün.
  resourceName   String?      @map("resource_name")

  // Free-form ek bilgi: degisen alan(lar), miktar farki, advance flag vs.
  details        Json         @default("{}")

  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
  @@schema("solar")
}

/// Müşteri/yatırımcı için public, tokenlı paylaşım linki. Auth gerektirmez.
/// Yönetici belirli tab'leri (BoQ, Analiz, DoR vb.) seçer, süre verir;
/// `/share/<token>` URL'i public olur. Revoked veya expired olunca 404 döner
/// ama satır audit/forensic için DB'de kalır.
model ShareLink {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id")
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String       @map("created_by_id") @db.Uuid
  // Yönetici notu — "Çimsa müşteri", "Yatırımcı XYZ" gibi iç etiket.
  customerLabel  String?      @map("customer_label")
  // Müşteri/yatırımcı e-postası — link e-posta ile gönderildiğinde kayıt
  // edilir, sonradan "Tekrar Mail At" butonuyla yeniden gönderebilmek için.
  // Boş bırakılırsa sadece link panoya kopyalanır, e-posta gönderilmez.
  recipientEmail String?      @map("recipient_email")
  // İçerilen tab kimlikleri: ["kesif-a", "kesif-b", "boq", "priced-boq", "analiz", "dor"]
  includedTabs   Json         @map("included_tabs")
  // null = süresiz
  expiresAt      DateTime?    @map("expires_at")
  viewCount      Int          @default(0) @map("view_count")
  lastViewedAt   DateTime?    @map("last_viewed_at")
  // Doluysa link iptal edilmiştir; public sayfada 404 döner.
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  activities     ProjectActivity[]

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@map("share_links")
  @@schema("solar")
}

model ProjectDetail {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kesifA    Json     @default("[]")
  kesifB    Json     @default("[]")
  timeline  Json     @default("{}")
  dor       Json     @default("[]")
  settings  Json     @default("{}")
  // Malzeme & Hizmet teklifi kalemleri (MATERIAL_SERVICE projelerinde kullanılır).
  // Her kalem: { id, kind, code, name, desc, unit, qty, currency, unitCost, marginPct }
  // quoteItems + settings = SON revizyonun aynası (geriye-uyumlu okuma için).
  quoteItems Json    @default("[]") @map("quote_items")
  // Teklif revizyonları: [{ id, label, createdAt, items, meta }]. Son eleman aktif.
  quoteRevisions Json @default("[]") @map("quote_revisions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("solar")
}

enum InstallationType {
  ROOFTOP
  GROUND_MOUNTED

  @@schema("solar")
}

enum SystemSize {
  SMALL
  LARGE

  @@schema("solar")
}

enum TariffType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL

  @@schema("solar")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SENT
  CLOSE_WIN
  CLOSE_LOST
  CANCELLED

  @@schema("solar")
}

/// Teklif tipi — anahtar teslim GES projesi mi yoksa malzeme/hizmet teklifi mi.
enum ProjectKind {
  TURNKEY           // Anahtar teslim GES projesi (tam akış)
  MATERIAL_SERVICE  // Malzeme & hizmet teklifi (sade kalem listesi)

  @@schema("solar")
}

/// Malzeme/hizmet kalemi türü.
enum QuoteItemKind {
  MALZEME
  HIZMET

  @@schema("solar")
}

/// Firma geneli malzeme/hizmet kataloğu — kalem kodu anahtardır. Kullanıcı
/// teklif kalemi girdikçe buraya upsert edilir; kod tekrar girildiğinde
/// ad/birim/son fiyat otomatik gelir.
model MaterialCatalogItem {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id") @db.Uuid
  code           String
  name           String
  unit           String        @default("adet")
  kind           QuoteItemKind @default(MALZEME)
  lastUnitCost   Float         @default(0) @map("last_unit_cost")
  currency       String        @default("USD")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("material_catalog_items")
  @@schema("solar")
}

/// Satış pipeline aşamaları — proje yaşam döngüsünden (Project.status) ayrı.
/// Yöneticinin satış sürecini izlemesi için.
enum PipelineStage {
  DRAFT         // Taslak (henüz müşteriye gönderilmemiş)
  SENT          // Müşteriye gönderildi (paylaşım linki üretilince otomatik)
  REVISED       // Müşteri revizyon istedi
  WON           // Closed Won (müşteri kabul etti veya manuel)
  LOST          // Closed Lost (manuel; lostReason zorunlu)
  CANCELLED     // Proje iptal edildi

  @@schema("solar")
}

/// Kayıp sebepleri — yıl sonu raporda "neden kaybediyoruz?" sorusunu cevaplar.
enum LostReason {
  PRICE          // Fiyatımız yüksekti
  TECHNICAL      // Teknik çözümümüz uymadı
  REFERENCE      // Referansımız/firmamız yetersiz bulundu
  TIMING         // Zamanlama uymadı (proje ertelendi/iptal)
  RELATIONSHIP   // Müşteri ilişkisi (mevcut sağlayıcıya gitti)
  OTHER          // Diğer

  @@schema("solar")
}

/// ProjectActivity tipleri — hem dahili (admin notu, telefon kaydı) hem
/// public (müşteri paylaşımı görüntüledi/yanıtladı) etkinlikleri kapsar.
enum ActivityType {
  CUSTOMER_VIEWED         // Müşteri paylaşım linkini ilk kez görüntüledi (otomatik)
  CUSTOMER_ACCEPTED       // Müşteri "Kabul Ediyorum" butonuna bastı
  CUSTOMER_REVISION       // Müşteri "Revizyon İste" butonuna bastı (mesajlı)
  CUSTOMER_QUESTION       // Müşteri "Soru Sor" butonuna bastı (mesajlı)
  INTERNAL_NOTE           // Yönetici/kullanıcı eklediği iç not
  PHONE_CALL              // Telefon görüşmesi kaydı
  EMAIL_SENT              // Mail gönderildi (manuel kayıt)
  STAGE_CHANGE            // Pipeline stage değiştirildi (otomatik)

  @@schema("solar")
}

/// Proje aktivite akışı — hem dahili etkinlikler (admin notları) hem public
/// share üzerinden müşteri yanıtları tek bir timeline'da toplanır. Pipeline
/// sayfasında kronolojik gösterilir.
model ProjectActivity {
  id              String        @id @default(cuid())
  projectId       String        @map("project_id")
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId  String        @map("organization_id") @db.Uuid

  type            ActivityType
  // Müşteri yanıtlarında müşterinin yazdığı not, iç notlarda kullanıcının metni.
  message         String?
  // Etkinliği kim tetikledi — internal user için actorId, public müşteri için
  // null (snapshot adı message/details içinde tutulur).
  actorId         String?       @map("actor_id") @db.Uuid
  actorEmail      String?       @map("actor_email")
  actorName       String?       @map("actor_name")

  // Public müşteri yanıtıysa hangi paylaşım linkinden geldiği (analitik için).
  shareLinkId     String?       @map("share_link_id")
  shareLink       ShareLink?    @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  // Free-form metadata: STAGE_CHANGE'de fromStage/toStage, vb.
  details         Json          @default("{}")

  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([organizationId, createdAt])
  @@index([type])
  @@map("project_activities")
  @@schema("solar")
}

model PricingSnapshot {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  referencePricePerKw Float
  baseTotalPrice      Float

  finalEquipmentCost    Float
  finalInstallationCost Float
  finalEngineeringCost  Float
  finalOtherCosts       Float
  finalTotalCost        Float
  profitMarginPercent   Float @default(0.20)
  finalSalePrice        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("solar")
}

model EquipmentItem {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   EquipmentCategory
  brand      String?
  model      String?
  quantity   Int
  unitPrice  Float
  totalPrice Float
  notes      String?
  sortOrder  Int               @default(0)

  @@schema("solar")
}

enum EquipmentCategory {
  PANEL
  INVERTER
  MOUNTING_SYSTEM
  DC_CABLE
  AC_CABLE
  JUNCTION_BOX
  MONITORING_SYSTEM
  PROTECTION_EQUIPMENT
  TRANSFORMER
  OTHER

  @@schema("solar")
}

model CostItem {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  description String
  amount      Float
  notes       String?

  @@schema("solar")
}

enum CostCategory {
  INSTALLATION_LABOR
  ENGINEERING_DESIGN
  PERMITS_LICENSING
  TRANSPORTATION
  COMMISSIONING
  INSURANCE
  OTHER

  @@schema("solar")
}

model Proposal {
  id          String    @id @default(cuid())
  projectId   String    @unique
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pdfUrl      String?
  generatedAt DateTime?
  sentAt      DateTime?
  version     Int       @default(1)

  coverNote        String?
  validityDays     Int     @default(30)
  includedSections Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("solar")
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique @map("organization_id") @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id])
  plan                 PlanType
  status               SubStatus
  monthlyProposalLimit Int
  currentMonthCount    Int          @default(0)
  periodStart          DateTime
  periodEnd            DateTime
  createdAt            DateTime     @default(now())

  @@schema("solar")
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE

  @@schema("solar")
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE

  @@schema("solar")
}

model ReferencePriceTable {
  id               String           @id @default(cuid())
  powerKw          Float
  installationType InstallationType
  pricePerKw       Float
  validFrom        DateTime
  notes            String?
  updatedAt        DateTime         @updatedAt

  @@schema("solar")
}

model ElectricityTariff {
  id            String     @id @default(cuid())
  type          TariffType
  unitPrice     Float
  effectiveDate DateTime
  source        String?

  @@schema("solar")
}

model PlatformSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@schema("solar")
}
